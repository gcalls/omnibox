# Runtime / integration test configuration for sdk-callpack.
# DO NOT populate this file with real credentials or commit .env to git.
# Maintainers: decrypt 1config.tar.gpg and run `bash 1config/cp.sh [internal|production]`
# (or `powershell -ExecutionPolicy Bypass -File 1config\cp.ps1 -Mode internal|production`)
# to generate `.env` from `1config/env/<mode>.env`.

# SIP User Agent configuration
GCALLS_SIP_WEBSOCKET=wss://sip-ws.example.com:7444
GCALLS_SIP_PROXY=sip-proxy.example.com:5060
GCALLS_SIP_EXTENSION=101
GCALLS_SIP_PASSWORD=example_sip_password

# CouchDB / PouchDB remote synchronization configuration
GCALLS_COUCHDB_HOST=http://localhost:5984
GCALLS_COUCHDB_DB=calllog_mock
GCALLS_COUCHDB_USERNAME=mock_user
GCALLS_COUCHDB_PASSWORD=mock_password

# Call recording domain (optional; used for functions.recordHost)
GCALLS_RECORD_HOST=recordings.example.com
