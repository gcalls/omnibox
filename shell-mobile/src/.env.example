# Biến runtime cho react-native-dotenv (import { BASE_URL } from '@env').
# KHÔNG tạo .env bằng tay: giải mã 1config rồi chạy `bash 1config/cp.sh [internal|production]`
# (hoặc `1config\cp.ps1 -Mode internal|production`) – script copy 1config/env/<mode>.env thành src/.env.

# URL trang f-callbox mà WebView tải (bắt buộc HTTPS)
BASE_URL=https://example.invalid
