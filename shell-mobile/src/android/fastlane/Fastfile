# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

# Cấu hình và secret được copy vào bởi `bash 1config/cp.sh` (hoặc cp.ps1):
#   src/android/fastlane/.env                                  – APP_ID, FIREBASE_* (fastlane tự nạp)
#   src/android/fastlane/secure/play-service-account.json      – service account Google Play
#   src/android/fastlane/secure/firebase-service-account.json  – service account Firebase App Distribution
# Có thể ghi đè đường dẫn bằng biến môi trường PLAY_JSON_KEY_PATH / FIREBASE_SA_PATH.
FASTLANE_DIR = File.expand_path(File.dirname(__FILE__))

def secure_file(env_name, file_name)
  path = ENV[env_name].to_s.empty? ? File.join(FASTLANE_DIR, "secure", file_name) : ENV[env_name]
  UI.user_error!("Thiếu #{path} – giải mã 1config rồi chạy 1config/cp.sh") unless File.exist?(path)
  path
end

def play_json_key
  secure_file("PLAY_JSON_KEY_PATH", "play-service-account.json")
end

def firebase_service_account
  secure_file("FIREBASE_SA_PATH", "firebase-service-account.json")
end

# File build được Gradle đặt tên {branch}-{versionName}.{apk|aab} (xem app/build.gradle).
# Lấy file mới nhất trong thư mục output của bản release.
def release_artifact(ext)
  kind = ext == "aab" ? "bundle" : "apk"
  files = Dir[File.expand_path("../app/build/outputs/#{kind}/release/*.#{ext}", FASTLANE_DIR)]
  UI.user_error!("Không tìm thấy file .#{ext} – hãy build trước") if files.empty?
  files.max_by { |f| File.mtime(f) }
end

platform :android do

  desc "Build Android"
  lane :buildAndroid do

    clean

    validate_play_store_json_key(
      json_key: play_json_key,
      timeout: 1000,
    )

    version_code = latest_googleplay_version_code
    puts "Updated version code: #{version_code + 1}"

      
    increment_version_code(
      gradle_file_path:"./app/build.gradle",
      version_code: version_code + 1
    )

    # gradle(task: "clean") 
    # build apk
    gradle(task: "assembleRelease") 
    #build bundle
    gradle(task: "assembleRelease bundle") 

  end
  # ---------------------------------------------------------------------------------------------------------


  desc "distribute to tester through firebase"
  lane :distribute do

    # Internal testing in Google Play does not send out emails and we do not want to share the opt-in link to your internal testers manually, therefore, we use Firebase instead.

    # service_credentials_file : 
    # to get service_credentials_file -> check following document -> Step 2. Authenticate with Firebase -> Use Firebase service account credentials
    # https://firebase.google.com/docs/app-distribution/android/distribute-fastlane


    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_ANDROID_APP_ID"),
      service_credentials_file: firebase_service_account,
      # Dùng group tester trên Firebase thay cho danh sách email trong repo
      groups: ENV["FIREBASE_TESTER_GROUPS"],
      release_notes_file: File.join(FASTLANE_DIR, 'metadata/android/release_note.txt'),
      android_artifact_type: "APK",
      android_artifact_path: release_artifact("apk"),
      debug: true,
    )


    # upload_to_play_store(
    #   track: 'internal',
    #   skip_upload_apk: true,
    #  skip_upload_changelogs: false,
    #   skip_upload_images: true,
    #   skip_upload_screenshots:true,
    #   aab:	release_artifact("aab"),
    #   )
  end




  # ---------------------------------------------------------------------------------------------------------

  desc "Push apk to Playstore"
  lane :upLoadToPlayStore do
  # production, beta, alpha, internal
    upload_to_play_store(
      track: 'production',
      json_key: play_json_key,
      skip_upload_apk: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots:true,
      aab:	release_artifact("aab"),
      )
  end

# ---------------------------------------------------------------------------------------------------------
  desc "release internal"
  lane :upLoadToInternal do
  # production, beta, alpha, internal
    upload_to_play_store(
      track: 'internal',
      json_key: play_json_key,
      skip_upload_apk: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots:true,
      aab:	release_artifact("aab"),
      )
  end

  # ---------------------------------------------------------------------------------------------------------
  desc "release beta"
  lane :upLoadToBeta do
  # production, beta, alpha, internal
    upload_to_play_store(
      track: 'beta',
      json_key: play_json_key,
      skip_upload_apk: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots:true,
      aab:	release_artifact("aab"),
      )
  end


    # ---------------------------------------------------------------------------------------------------------
    desc "realease alpha"
    lane :upLoadToAlpha do
    # production, beta, alpha, internal
      upload_to_play_store(
        track: 'alpha',
        json_key: play_json_key,
        skip_upload_apk: true,
        skip_upload_changelogs: false,
        skip_upload_images: true,
        skip_upload_screenshots:true,
        aab:	release_artifact("aab"),
        )
    end


  # ---------------------------------------------------------------------------------------------------------

  desc "Push apk to tester"
  lane :demo do
    buildAndroid
    distribute
    upLoadToInternal
  end
  # ---------------------------------------------------------------------------------------------------------
  
  desc "realease beta alpha"
  lane :uploadBetaALpha do
    buildAndroid
    upLoadToBeta
    upLoadToAlpha
  end

  # ---------------------------------------------------------------------------------------------------------

  desc "Push apk to playstore (production)"
  lane :production do
    buildAndroid
    distribute
    upLoadToPlayStore
  end

  lane :clean do
    gradle(task: "clean")
  end



  def latest_googleplay_version_code
    internalVersionCodes = google_play_track_version_codes(track: 'internal', json_key: play_json_key)
    productionVersionCodes = google_play_track_version_codes(
      track: 'production',
      json_key: play_json_key,
      )
    betaVersionCodes = google_play_track_version_codes(
      track: 'beta',
      json_key: play_json_key,
      )
    alphaVersionCodes = google_play_track_version_codes(
      track: 'alpha',
      json_key: play_json_key,
      )
    
  
    # puts version codes from all tracks into the same array
    versionCodes = [
      productionVersionCodes, 
      betaVersionCodes, 
      alphaVersionCodes, 
      internalVersionCodes
    ].reduce([], :concat)
  
    # returns the highest version code from array
    return versionCodes.max
  end

end

# Kiểm tra key: bundle exec fastlane run validate_play_store_json_key json_key:fastlane/secure/play-service-account.json
